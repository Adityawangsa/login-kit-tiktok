# Server Configuration
PORT=4000
NODE_ENV=development

# TikTok Developer App Credentials
# Dapatkan dari: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Redirect URI (Harus sama persis dengan yang didaftarkan di TikTok Developer Portal)
TIKTOK_REDIRECT_URI=http://localhost:4000/auth/tiktok/callback

# OAuth Scopes (Dipisahkan tanda koma)
# Default: user.info.basic
TIKTOK_SCOPES=user.info.basic
